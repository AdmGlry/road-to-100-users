# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public "anon" key (safe in the browser, protected by RLS)
SUPABASE_SERVICE_ROLE_KEY=           # SECRET: server only (cron, API routes). Never expose.

# --- Google OAuth for Gmail (Sprint 3) — separate from Supabase Google login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<domaine>/api/google/oauth/callback

# --- Encryption of Google tokens at rest (AES-256-GCM) ---
TOKEN_ENCRYPTION_KEY=                # 32 bytes in base64: openssl rand -base64 32

# --- LLM ---
LLM_PROVIDER=anthropic               # anthropic | openai | openrouter
LLM_API_KEY=                         # SECRET: provider API key (OpenRouter keys start with sk-or-)
LLM_MODEL_FAST=                      # cheap model: CV extraction, NAF, scoring, classification
LLM_MODEL_SMART=                     # stronger model: email writing

# --- Cron (GitHub Actions calls /api/cron/* with "Authorization: Bearer <CRON_SECRET>") ---
CRON_SECRET=                         # openssl rand -base64 32

# --- Optional ---
RESEND_API_KEY=                      # optional, interview notifications
ADMIN_EMAILS=                        # comma-separated list of admin emails
APP_URL=                             # e.g. https://road-to-100-users.vercel.app
